{
    "mcp": {
        "servers": {
            "ado": {
                "type": "stdio",
                "command": "npx",
                "args": [
                    "-y",
                    "@azure-devops/mcp",
                    "${input:ado_org}"
                ]
            },
            "memory": {
                "command": "npx",
                "args": [
                    "-y",
                    "@modelcontextprotocol/server-memory"
                ]
            }
        },
        "inputs": [
            {
                "id": "ado_org",
                "type": "promptString",
                "description": "Azure DevOps organization name (e.g. 'contoso')"
            }
        ]
    }
}
